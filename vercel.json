{
  "rewrites": [
    {
      "source": "/api/bookmakers/bantubet-normalize",
      "destination": "/api/bookmakers/normalize?provider=bantu"
    },
    {
      "source": "/api/bookmakers/elephantbet-normalize",
      "destination": "/api/bookmakers/normalize?provider=elephant"
    },
    {
      "source": "/api/bookmakers/compare",
      "destination": "/api/bookmakers/compare-all?mode=fixtures"
    },
    {
      "source": "/api/bookmakers/compare-swarm",
      "destination": "/api/bookmakers/compare-all?mode=swarm"
    },
    {
      "source": "/api/pipeline/build-tickets",
      "destination": "/api/pipeline?action=build-tickets"
    },
    {
      "source": "/api/pipeline/discover-fixtures",
      "destination": "/api/pipeline?action=discover-fixtures"
    },
    {
      "source": "/api/pipeline/save-analysis",
      "destination": "/api/pipeline?action=save-analysis"
    },
    {
      "source": "/api/test-match-validation",
      "destination": "/api/test-discovery?action=validate"
    }
  ],
  "crons": [
    {
      "path": "/api/bookmakers/collect-daily",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/bookmakers/collect-daily.js": {
      "maxDuration": 60
    },
    "api/bookmakers/ingest-swarm.js": {
      "maxDuration": 60
    }
  }
}
